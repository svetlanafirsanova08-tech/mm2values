-- 5. ЛОГИКА ПОДСЧЕТА И ВЫВОДА
-- ==========================================
local function getItemData(itemName)
    if not isDataLoaded then return 0, "...", 0 end
    local data = ITEM_DATA[itemName]
    if data then
        return data.value or 0, data.stability or "Unknown", data.change or 0
    end
    return 0, "Unknown", 0
end

local function check(lbl)
    return lbl.Text ~= "" and lbl.Text ~= "0" and lbl.Parent.Parent.Visible == true
end

function updateall()
    local total = 0
    for i = 1, 4 do
        if check(Notmy[i]) then total = total + (tonumber(Notmy[i].Text) or 0) end
    end
    for i = 1, 4 do
        if check(Mytext[i]) then total = total - (tonumber(Mytext[i].Text) or 0) end
    end

    all.Text = tostring(total)
    if total > 0 then all.TextColor3 = Color3.fromRGB(0, 255, 127)
    elseif total < 0 then all.TextColor3 = Color3.fromRGB(255, 50, 50)
    else all.TextColor3 = Color3.fromRGB(255, 255, 255) end
end

local function getAmount(amountObj)
    if amountObj.Text == "" or amountObj.Text == "0" then return 1 end
    return tonumber(string.match(amountObj.Text, "%d+")) or 1
end

function updateInput()
    pcall(function()
        for i = 1, 4 do
            -- МОИ ПРЕДМЕТЫ
            local item = Players.LocalPlayer.PlayerGui.TradeGUI.Container.Trade.YourOffer.Container["NewItem" .. i]
            local textLabel = item.ItemName.Label
            local val, stab, chg = 0, "...", 0
            
            if textLabel.Text ~= "" then
                if item:FindFirstChild("Tags") and item.Tags:FindFirstChild("Chroma") and item.Tags.Chroma.Visible then
                    val, stab, chg = getItemData("Chroma " .. textLabel.Text)
                else
                    local bg = item.ItemName.BackgroundColor3
                    if bg == Color3.fromRGB(255, 0, 179) then val, stab, chg = getItemData(textLabel.Text .. " Godly")
                    elseif bg == Color3.fromRGB(220, 0, 5) then val, stab, chg = getItemData(textLabel.Text .. " Legendary")
                    elseif bg == Color3.fromRGB(100, 10, 255) then val, stab, chg = getItemData(textLabel.Text .. " Ancient")
                    elseif bg == Color3.fromRGB(230, 200, 0) then val, stab, chg = getItemData(textLabel.Text .. " Vintage")
                    else val, stab, chg = getItemData(textLabel.Text .. " Unique") end
                end
            end
            
            Mytext[i].Text = tostring(val * getAmount(item.Container.Amount))
            Stable[i].Text = stab
            
            if chg > 0 then
                Change[i].Text = string.format("+%.1f%%", chg)
                Change[i].TextColor3 = Color3.fromRGB(0, 255, 0)
            elseif chg < 0 then
                Change[i].Text = string.format("%.1f%%", chg)
                Change[i].TextColor3 = Color3.fromRGB(255, 50, 50)
            else
                Change[i].Text = ""
            end

            -- ЧУЖИЕ ПРЕДМЕТЫ
            local nItem = Players.LocalPlayer.PlayerGui.TradeGUI.Container.Trade.TheirOffer.Container["NewItem" .. i]
            local nLabel = nItem.ItemName.Label
            local nVal, nStab, nChg = 0, "...", 0
            
            if nLabel.Text ~= "" then
                if nItem:FindFirstChild("Tags") and nItem.Tags:FindFirstChild("Chroma") and nItem.Tags.Chroma.Visible then
                    nVal, nStab, nChg = getItemData("Chroma " .. nLabel.Text)
                else
                    local bg = nItem.ItemName.BackgroundColor3
                    if bg == Color3.fromRGB(255, 0, 179) then nVal, nStab, nChg = getItemData(nLabel.Text .. " Godly")
                    elseif bg == Color3.fromRGB(220, 0, 5) then nVal, nStab, nChg = getItemData(nLabel.Text .. " Legendary")
                    elseif bg == Color3.fromRGB(100, 10, 255) then nVal, nStab, nChg = getItemData(nLabel.Text .. " Ancient")
                    elseif bg == Color3.fromRGB(230, 200, 0) then nVal, nStab, nChg = getItemData(nLabel.Text .. " Vintage")
                    else nVal, nStab, nChg = getItemData(nLabel.Text .. " Unique") end
                end
            end
            
            Notmy[i].Text = tostring(nVal * getAmount(nItem.Container.Amount))
            NotStable[i].Text = nStab
            
            if nChg > 0 then
                NotChange[i].Text = string.format("+%.1f%%", nChg)
                NotChange[i].TextColor3 = Color3.fromRGB(0, 255, 0)
            elseif nChg < 0 then
                NotChange[i].Text = string.format("%.1f%%", nChg)
                NotChange[i].TextColor3 = Color3.fromRGB(255, 50, 50)
            else
                NotChange[i].Text = ""
            end
        end
    end)
end

pcall(function()
    while true do
        task.wait(0.5)
        if isDataLoaded then
            updateInput()
            updateall()
        end
    end
end)

