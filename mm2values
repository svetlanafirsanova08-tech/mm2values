local function loadPrices()
    local success, response = pcall(function()
        return request({
            Url = "http://127.0.0.1:5000/prices",
            Method = "GET"
        })
    end)

    if success and response.StatusCode == 200 then
        ITEM_DATA = HttpService:JSONDecode(response.Body)
        isDataLoaded = true
        print("[TradeHelper] Цены обновлены! Загружено: " .. tostring(#ITEM_DATA))
    else
        print("[TradeHelper] Ошибка: Python сервер выключен или не отвечает.")
    end
end

task.spawn(function()
    while true do
        loadPrices()
        task.wait(60) -- Обновляем цены раз в минуту
    end
end)

