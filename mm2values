local function loadPrices()
    local success, response = pcall(function()
        return request({ Url = "http://127.0.0.1:5000/prices", Method = "GET" })
    end)
    if success and response.StatusCode == 200 then
        _G.TradeHelper.ITEM_DATA = HttpService:JSONDecode(response.Body)
        _G.TradeHelper.isDataLoaded = true
    end
end

