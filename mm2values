function accepttrade()
    local RunService = game:GetService("RunService")
    connection = RunService.RenderStepped:Connect(function()
        if button.BackgroundColor3 == Color3.fromRGB(255, 50, 50) or Players.LocalPlayer.PlayerGui.TradeGUI.Enabled ~= true or Players.LocalPlayer.PlayerGui.TradeGUI.Container.Trade.Actions.Accept.Cooldown.Visible == true then
            button.Text = "Accept OFF"
            btnGradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 100, 100)), ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 0, 0))}
            button.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            connection:Disconnect()
        elseif button.BackgroundColor3 == Color3.fromRGB(0, 255, 127) then
            local acceptBtn = Players.LocalPlayer.PlayerGui.TradeGUI.Container.Trade.Actions.Accept.Confirm.ActionButton
            local x = acceptBtn.AbsolutePosition.X + acceptBtn.AbsoluteSize.X / 2
            local y = acceptBtn.AbsolutePosition.Y + acceptBtn.AbsoluteSize.Y * 2
            if Players.LocalPlayer.PlayerGui.TradeGUI.Container.Trade.TheirOffer.Accepted.Visible == true or Players.LocalPlayer.PlayerGui.TradeGUI.Container.Trade.Actions.Accept.Confirm.Visible ~= true and Players.LocalPlayer.PlayerGui.TradeGUI.Container.Trade.Actions.Accept.AddItem.Visible ~= true then
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
            end
        end
    end)
end

button.MouseButton1Click:Connect(function()
