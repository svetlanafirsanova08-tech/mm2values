local function loadPrices()
    local success, response = pcall(function()
        return request({ Url = "http://127.0.0.1:5000/prices", Method = "GET" })
    end)

    if success and response.StatusCode == 200 then
        ITEM_DATA = HttpService:JSONDecode(response.Body)
        isDataLoaded = true
        print("[TradeHelper] Цены и изменения обновлены!")
    end
end

task.spawn(function()
    while true do
        loadPrices()
        task.wait(60)
    end
end)

