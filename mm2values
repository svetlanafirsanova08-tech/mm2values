local function createLabel(parent, pos, color, size, textSize)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = parent
    lbl.Text = "..."
    lbl.Size = size
    lbl.Position = pos
    lbl.ZIndex = 999
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Font = Enum.Font.GothamBlack
    lbl.TextSize = textSize or 24
    lbl.TextStrokeTransparency = 0.5 -- Тень для читаемости
    lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    return lbl
end

