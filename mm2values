local function doRejoin(serverId)
    if serverId and serverId ~= "" then
        print("[ServerManager] Перезаход на сервер: " .. serverId)
        pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, Players.LocalPlayer) end)
    else
        print("[ServerManager] Перезаход на рандомный сервер...")
        pcall(function() TeleportService:Teleport(game.PlaceId, Players.LocalPlayer) end)
    end
end

btnJoin.MouseButton1Click:Connect(function()
    local serverId = input.Text:match("%w+")
    doRejoin(serverId)
end)

btnFind.MouseButton1Click:Connect(function()
    if _G.TradeHelper.IsSearching then
        _G.TradeHelper.IsSearching = false
        btnFind.Text = "Искать сервер"
        btnFind.BackgroundColor3 = Color3.fromRGB(50, 100, 200)
        return
    end

    _G.TradeHelper.IsSearching = true
    btnFind.Text = "Поиск (Нажми чтобы стоп)"
    btnFind.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
    
    task.spawn(function()
        local targetPlayers = tonumber(inputPlayers.Text) or 10
        local targetMonths = tonumber(inputMonths.Text) or 6
        local cursor = ""
        local page = 1
        
        while _G.TradeHelper.IsSearching do
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=false"
            if cursor ~= "" then url = url .. "&cursor=" .. cursor end
            
            local success, response = pcall(function() return request({ Url = url, Method = "GET" }) end)
            if not success or response.StatusCode ~= 200 then
                print("[ServerManager] Ошибка API. Ждем 5 сек...")
                task.wait(5)
                continue
            end
            
            local data = HttpService:JSONDecode(response.Body)
            if not data.data or #data.data == 0 then
                print("[ServerManager] Страницы закончились. Начинаем сначала.")
                cursor = ""
                page = 1
                task.wait(2)
                continue
            end
            
            print("[ServerManager] Сканируем страницу " .. page .. "...")
            
            for _, server in ipairs(data.data) do
                if not _G.TradeHelper.IsSearching then break end
                
                if server.playing == targetPlayers then
                    local allOld = true
                    for _, player in ipairs(server.players) do
                        local userRes = request({ Url = "https://users.roblox.com/v1/users/" .. player.id, Method = "GET" })
                        if userRes.StatusCode == 200 then
                            local userData = HttpService:JSONDecode(userRes.Body)
                            local year, month = userData.created:match("^(%d+)-(%d+)")
                            local now = os.date("*t")
                            local age = (now.year - tonumber(year)) * 12 + (now.month - tonumber(month))
                            if age < targetMonths then allOld = false break end
                        else
                            allOld = false break
                        end
                        task.wait(0.2) -- Защита от бана API
                    end
                    
                    if allOld then
                        print("[ServerManager] Найден идеальный сервер: " .. server.id)
                        input.Text = server.id
                        _G.TradeHelper.IsSearching = false
                        btnFind.Text = "Сервер найден!"
                        btnFind.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
                        task.wait(2)
                        btnFind.Text = "Искать сервер"
                        btnFind.BackgroundColor3 = Color3.fromRGB(50, 100, 200)
                        return
                    end
                end
            end
            
            cursor = data.nextPageCursor or ""
            page = page + 1
            task.wait(1)
        end
    end)
end)

